Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: EKF Pose
      Topic:
        Value: /ekf_pose
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: EKF Map Lines
      Topic:
        Value: /ekf_map_lines
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0.78
    Saved: ~
